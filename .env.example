# AUREON Environment Variables
ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=5173

# Stage 4 analytical thresholds (not trading recommendations)
AUREON_SIGNAL_WATCHLIST_Z=1.5
AUREON_SIGNAL_STRONG_Z=2.0
AUREON_SIGNAL_NEUTRAL_Z=1e-12
AUREON_SIGNAL_MIN_VOLUME=500
AUREON_SIGNAL_MIN_OPEN_INTEREST=1000
AUREON_SIGNAL_MIN_DAYS_TO_EXPIRY=5
AUREON_SIGNAL_MIN_PEERS=2
AUREON_SIGNAL_MIN_HISTORY=3
AUREON_SIGNAL_ROLLING_WINDOW=5

# Stage 5 walk-forward backtest assumptions (estimated, not verified costs)
AUREON_BACKTEST_ENTRY_Z=2.0
AUREON_BACKTEST_EXIT_Z=0.5
AUREON_BACKTEST_MAX_HOLDING_DAYS=20
AUREON_BACKTEST_MIN_VOLUME=500
AUREON_BACKTEST_MIN_OPEN_INTEREST=1000
AUREON_BACKTEST_MIN_DAYS_TO_EXPIRY=5
AUREON_BACKTEST_COST_RATE=0.0005
AUREON_BACKTEST_INITIAL_CAPITAL=1000000
AUREON_BACKTEST_BENCHMARK_SYMBOL=GOLDTEN
