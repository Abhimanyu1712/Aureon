# AUREON Environment Variables
ENVIRONMENT=development
API_PORT=8000
FRONTEND_PORT=5173

# Stage 4 analytical thresholds (not trading recommendations)
AUREON_SIGNAL_WATCHLIST_Z=1.5
AUREON_SIGNAL_STRONG_Z=2.0
AUREON_SIGNAL_NEUTRAL_Z=1e-12
AUREON_SIGNAL_MIN_VOLUME=500
AUREON_SIGNAL_MIN_OPEN_INTEREST=1000
AUREON_SIGNAL_MIN_DAYS_TO_EXPIRY=5
AUREON_SIGNAL_MIN_PEERS=2
AUREON_SIGNAL_MIN_HISTORY=3
AUREON_SIGNAL_ROLLING_WINDOW=5
